        {"verb": "give", "target_id": "item.firewood_bundle", "args": {"recipient": "npc.foreman_laotie"}}
      ],
      "expect": {
        "state": [
          {"owner": "$actor", "namespace": "quest", "key": "quest.find_work", "equals": "completed"},
          {"owner": "$actor", "namespace": "wallet", "key": "currency", "equals": 15},
          {"owner": "item.firewood_bundle", "namespace": "inventory", "key": "carrier", "equals": "npc.foreman_laotie"}
        ],
        "events": ["dialogue.responded", "inventory.item_given", "quest.completed"],
        "status": "completed"
      },
      "tags": ["smoke", "dialogue", "quest"]
    }
  ]
