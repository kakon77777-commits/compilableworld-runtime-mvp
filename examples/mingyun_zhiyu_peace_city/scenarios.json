{
  "scenarios": [
    {
      "scenario_id": "peace_city.find_work",
      "title": "與老鐵交談並完成找份差事",
      "actor_id": "player.newcomer",
      "given": [],
      "when": [
        {"verb": "move", "args": {"direction": "north"}},
        {"verb": "move", "args": {"direction": "west"}},
        {"verb": "talk", "target_id": "npc.foreman_laotie", "args": {"topic": "work"}},
        {"verb": "move", "args": {"direction": "east"}},
        {"verb": "take", "target_id": "item.firewood_bundle"},
