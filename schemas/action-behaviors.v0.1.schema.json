{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compilableworld.schema/action-behaviors/v0.1",
  "title": "CompilableWorld Action-scope behavior source v0.1",
  "description": "Bounded scheduled ActionIR lifecycles with deterministic target-based interruption.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "behaviors"],
  "properties": {
    "format": { "const": "compilableworld.action-behaviors/v0.1" },
    "behaviors": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/behavior" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "behavior_id", "title", "verb", "duration_ticks",
        "completion_module", "concurrency", "interrupt_on"
      ],
      "properties": {
        "behavior_id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "verb": { "$ref": "#/$defs/id" },
        "duration_ticks": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "completion_module": { "$ref": "#/$defs/id" },
        "concurrency": { "const": "one_per_actor" },
        "interrupt_on": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "enum": [
              "combat.actor_defeated",
              "combat.damage_applied",
              "movement.actor_moved"
            ]
          }
        }
      }
    }
  }
}
