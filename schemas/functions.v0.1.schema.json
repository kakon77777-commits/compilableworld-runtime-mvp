{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compilableworld.schema/functions/v0.1",
  "title": "CompilableWorld FunctionIR source v0.1",
  "description": "Pure numeric FunctionIR definitions. Semantic arity and duplicate-ID checks remain Compiler rules.",
  "type": "object",
  "additionalProperties": false,
  "required": ["functions"],
  "properties": {
    "functions": {
      "type": "array",
      "items": { "$ref": "#/$defs/function" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "expression": {
      "oneOf": [
        { "type": "number" },
        {
          "type": "object",
          "additionalProperties": false,
          "oneOf": [
            {
              "required": ["ref"],
              "properties": { "ref": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } }
            },
            {
              "required": ["const"],
              "properties": { "const": { "type": "number" } }
            },
            {
              "required": ["op", "args"],
              "properties": {
                "op": { "enum": ["add", "sub", "mul", "div", "min", "max", "neg", "clamp", "round"] },
                "args": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/expression" }
                }
              }
            }
          ]
        }
      ]
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function_id", "version", "purity", "inputs", "output", "expression"],
      "properties": {
        "function_id": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "minLength": 1 },
        "purity": { "const": "pure" },
        "inputs": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "const": "number" }
        },
        "output": { "const": "number" },
        "expression": { "$ref": "#/$defs/expression" }
      }
    }
  }
}
