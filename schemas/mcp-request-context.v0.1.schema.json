{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compilableworld.schema/mcp-request-context/v0.1",
  "title": "CompilableWorld Trusted MCP Request Context Metadata",
  "description": "Safe diagnostic projection of Host-bound request context. Credential values are never part of this projection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "request_id",
    "transport",
    "client_id",
    "authorization_present",
    "session_token_present"
  ],
  "properties": {
    "format": {
      "const": "compilableworld.mcp-request-security/v0.1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "transport": {
      "type": "string",
      "minLength": 1
    },
    "client_id": {
      "type": "string",
      "minLength": 1
    },
    "peer": {
      "type": ["string", "null"]
    },
    "authorization_present": {
      "type": "boolean"
    },
    "session_token_present": {
      "type": "boolean"
    }
  }
}
