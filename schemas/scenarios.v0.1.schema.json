{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compilableworld.schema/scenarios/v0.1",
  "title": "CompilableWorld ScenarioIR source v0.1",
  "description": "Portable Given/When/Then scenarios executed through the normal Kernel ActionIR path.",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenarios"],
  "properties": {
    "scenarios": {
      "type": "array",
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "actorRef": {
      "anyOf": [
        { "const": "$actor" },
        { "$ref": "#/$defs/id" }
      ]
    },
    "jsonScalar": {
      "type": ["string", "number", "boolean", "null"]
    },
    "stateAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "namespace", "key", "equals"],
      "properties": {
        "owner": { "$ref": "#/$defs/actorRef" },
        "namespace": {
          "enum": ["position", "inventory", "door", "health", "status", "quest", "wallet", "fsm", "combat", "magic"]
        },
        "key": { "$ref": "#/$defs/id" },
        "equals": { "$ref": "#/$defs/jsonScalar" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verb"],
      "properties": {
        "verb": { "$ref": "#/$defs/id" },
        "actor": { "$ref": "#/$defs/actorRef", "default": "$actor" },
        "target_id": { "$ref": "#/$defs/id" },
        "args": { "type": "object", "default": {} },
        "delay": { "type": "integer", "minimum": 0, "default": 0 }
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "array",
          "items": { "$ref": "#/$defs/stateAssertion" },
          "default": []
        },
        "events": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "default": []
        },
        "status": {
          "enum": ["completed", "failed"],
          "default": "completed"
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "title", "when", "expect"],
      "properties": {
        "scenario_id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "actor_id": { "$ref": "#/$defs/id" },
        "given": {
          "type": "array",
          "items": { "$ref": "#/$defs/stateAssertion" },
          "default": []
        },
        "when": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/action" }
        },
        "expect": { "$ref": "#/$defs/expect" },
        "tags": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "default": []
        }
      }
    }
  }
}
