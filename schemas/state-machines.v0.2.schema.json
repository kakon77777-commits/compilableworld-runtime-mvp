{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compilableworld.schema/state-machines/v0.2",
  "title": "CompilableWorld scoped StateIR source v0.2",
  "description": "Bounded event-driven state machines with fail-closed owner/actor StateStore conditions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "state_machines"],
  "properties": {
    "format": { "const": "compilableworld.state-machines/v0.2" },
    "state_machines": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/stateMachine" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "jsonScalar": {
      "type": ["string", "number", "boolean", "null"]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition_id", "subject", "namespace", "key", "operator", "value"],
      "properties": {
        "condition_id": { "$ref": "#/$defs/id" },
        "subject": { "enum": ["owner", "actor"] },
        "namespace": {
          "enum": [
            "combat", "door", "exploration", "fsm", "health", "inventory",
            "magic", "position", "quest", "status", "wallet"
          ]
        },
        "key": { "$ref": "#/$defs/id" },
        "operator": {
          "enum": [
            "equals", "not_equals", "less_than", "less_or_equal",
            "greater_than", "greater_or_equal"
          ]
        },
        "value": { "$ref": "#/$defs/jsonScalar" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transition_id", "from", "on", "to", "when"],
      "properties": {
        "transition_id": { "$ref": "#/$defs/id" },
        "from": { "$ref": "#/$defs/id" },
        "on": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "event_match": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$" },
          "additionalProperties": { "$ref": "#/$defs/jsonScalar" }
        },
        "when": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/condition" }
        },
        "priority": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      }
    },
    "stateMachine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_machine_id", "title", "owner_scope", "owner_id", "states",
        "initial_state", "persistence", "visibility", "authority", "transitions"
      ],
      "properties": {
        "state_machine_id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "owner_scope": { "enum": ["world", "region", "scene", "entity", "system"] },
        "owner_id": { "$ref": "#/$defs/id" },
        "states": {
          "type": "array",
          "minItems": 2,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "initial_state": { "$ref": "#/$defs/id" },
        "persistence": { "const": "runtime" },
        "visibility": { "enum": ["public", "observable", "inferred", "private", "system_only"] },
        "authority": { "const": "state_machine.core" },
        "transitions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/transition" }
        }
      }
    }
  }
}
