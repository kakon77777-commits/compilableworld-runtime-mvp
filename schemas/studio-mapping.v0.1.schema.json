{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compilableworld.schema/studio-mapping/v0.1",
  "title": "CompilableWorld Studio mapping v0.1",
  "description": "Human-reviewed bindings from Studio World IR to Runtime-facing room, table, EventIR, bounded requirements, and guard decisions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "world_ir_format", "entities", "state_machines"],
  "properties": {
    "format": { "const": "compilableworld.studio-mapping/v0.1" },
    "world_ir_format": { "const": "compilableworld.studio-world-ir/v0.1" },
    "entities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["room"],
        "properties": {
          "room": { "type": ["string", "null"], "minLength": 1 },
          "target_table": { "enum": ["entities", "items"] }
        }
      }
    },
    "state_machines": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_mappings"],
        "properties": {
          "target": { "enum": ["quest", null] },
          "guard_policy": { "enum": ["none", "state_conditions", "runtime_module", "external_review", "drop_with_approval"] },
          "event_mappings": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["event_type"],
              "properties": {
                "event_type": {
                  "enum": [
                    "action.failed",
                    "action.child_started",
                    "action.child_completed",
                    "action.child_failed",
                    "action.scheduled",
                    "action.started",
                    "action.progressed",
                    "action.retry_scheduled",
                    "action.completed",
                    "action.cancelled",
                    "action.interrupted",
                    "combat.actor_defeated",
                    "combat.attack_missed",
                    "combat.damage_applied",
                    "dialogue.responded",
                    "dialogue.spoken",
                    "door.opened",
                    "door.unlocked",
                    "exploration.searched",
                    "fsm.completed",
                    "fsm.failed",
                    "inventory.item_added",
                    "inventory.item_given",
                    "inventory.item_removed",
                    "magic.cast",
                    "movement.actor_moved",
                    "quest.completed",
                    "quest.failed",
                    null
                  ]
                },
                "event_match": {
                  "type": "object",
                  "maxProperties": 16,
                  "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$" },
                  "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
                },
                "requirements": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "string",
                    "pattern": "^(reach:[a-z][a-z0-9_.-]*|deliver:[a-z][a-z0-9_.-]*:[a-z][a-z0-9_.-]*)$"
                  }
                },
                "priority": { "type": "integer", "minimum": 0, "maximum": 1000000 },
                "reward": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "currency": { "type": "integer", "minimum": 0, "maximum": 1000000000 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "notes": { "type": "string" }
  }
}
